# ==============================================================================
# CONFIGURATION NAJAHLEARN LMS - PLATEFORME E-LEARNING & GESTION SCOLAIRE
# ==============================================================================

# Port d'??coute du serveur
PORT=3000

# Environnement (development / production)
NODE_ENV=development

# Cl?? secr??te pour la signature des sessions et jetons anti-CSRF
JWT_SECRET=<GENERATE_48_BYTES_BASE64>
CSRF_SECRET=<GENERATE_48_BYTES_BASE64>

# Origines autoris??es par la politique CORS restreinte (s??par??es par des virgules)
ALLOWED_ORIGINS="http://localhost:3000"

# ------------------------------------------------------------------------------
# BASE DE DONN??ES RELATIONNELLE POSTGRESQL (CONNEXION POOL & DRIZZLE KIT)
# ------------------------------------------------------------------------------
SQL_HOST="localhost"
SQL_DB_NAME="najahlearn"
SQL_USER="najahlearn_app"
SQL_PASSWORD="remplacer_par_mot_de_passe_applicatif"
SQL_ADMIN_USER="najahlearn_admin"
SQL_ADMIN_PASSWORD="remplacer_par_mot_de_passe_admin"

# Fuseau horaire et devise par d??faut
DEFAULT_TIMEZONE="Africa/Algiers"
DEFAULT_CURRENCY="DZD"

# ------------------------------------------------------------------------------
# INT??GRATION VISIOCONF??RENCE (ZOOM API - SERVER-TO-SERVER OAUTH)
# Laisser vide pour utiliser le mode d??mo ou la visioconf??rence WebRTC int??gr??e
# ------------------------------------------------------------------------------
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
