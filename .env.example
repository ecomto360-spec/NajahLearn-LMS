STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# MESSAGERIE TRANSACTIONNELLE SMTP & FILE D'ATTENTE (FR / AR HTML)
# Laisser vide en d??veloppement pour utiliser le mode bac ?? sable avec aper??u HTML int??gr??
# ------------------------------------------------------------------------------
SMTP_HOST=""
